{
  "description": "Load minimal Perture connection context.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/deliver-corrections.mjs\"",
            "commandWindows": "node \"$env:CLAUDE_PLUGIN_ROOT/hooks/deliver-corrections.mjs\"",
            "statusMessage": "Checking Perture",
            "additionalContextLimit": 1000,
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/deliver-corrections.mjs\"",
            "commandWindows": "node \"$env:CLAUDE_PLUGIN_ROOT/hooks/deliver-corrections.mjs\"",
            "statusMessage": "Checking Perture",
            "additionalContextLimit": 1000,
            "timeout": 5
          }
        ]
      }
    ]
  }
}
